[gd_resource type="Resource" format=3]
[ext_resource type="Script" path="res://scripts/npc/npc_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/npc/dialogue_page.gd" id="2"]
[sub_resource type="Resource" id="p0"]
script = ExtResource("2")
text = "Welcome to Briar Crossing. The waystone heals you for free. Take Briar at the Gate and follow the north road to Briarwood Verge. Click a mossling to approach and attack; keep the group in front of your blade. You can meet Mara before or after your first hunt."
responses = Array[Dictionary]([{"text": "What lies farther out?", "next": 1}, {"text": "I will prepare.", "action": "close"}])
[sub_resource type="Resource" id="p1"]
script = ExtResource("2")
text = "Old Pine Hollow shelters grown mosslings. Beyond it, the Broken Cairn belongs to ironbacks. A better blade and layered armor will matter there. The refuge shelters you if a hunt goes wrong."
responses = Array[Dictionary]([{"text": "I have survived my first hunts.", "next": 2, "min_level": 2}, {"text": "Back to the refuge.", "action": "close"}])
[sub_resource type="Resource" id="p2"]
script = ExtResource("2")
text = "Then take your time with the ironbacks. Their heavy shells hide valuable old steel. Leave room in your pack before you go."
responses = Array[Dictionary]([{"text": "I understand.", "action": "close"}])
[resource]
script = ExtResource("1")
id = &"warden"
display_name = "Warden Elric"
role = &"warden"
clothing_color = Color(0.26, 0.35, 0.25, 1)
pages = Array[ExtResource("2")]([SubResource("p0"), SubResource("p1"), SubResource("p2")])
