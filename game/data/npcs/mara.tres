[gd_resource type="Resource" format=3]
[ext_resource type="Script" path="res://scripts/npc/npc_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/npc/dialogue_page.gd" id="2"]
[ext_resource type="Resource" path="res://data/shops/refuge_supplies.tres" id="3"]
[sub_resource type="Resource" id="p0"]
script = ExtResource("2")
text = "A sound edge and a stitched coat go farther than brave words. I buy moss shards and spare gear. What do you need?"
responses = Array[Dictionary]([{"text": "Show me your wares.", "action": "shop"}, {"text": "Which gear should I choose?", "next": 1}, {"text": "Farewell.", "action": "close"}])
[sub_resource type="Resource" id="p1"]
script = ExtResource("2")
text = "Try the Marchguard Sword first, then a Quilted Jack. Bring back what the mosslings leave behind; sell the spare pieces and save for boots."
responses = Array[Dictionary]([{"text": "Let us trade.", "action": "shop"}, {"text": "Thank you.", "action": "close"}])
[resource]
script = ExtResource("1")
id = &"mara"
display_name = "Mara Fen"
role = &"merchant"
clothing_color = Color(0.5, 0.26, 0.12, 1)
pages = Array[ExtResource("2")]([SubResource("p0"), SubResource("p1")])
shop = ExtResource("3")
