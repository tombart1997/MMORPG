[resource]
script = ExtResource("1")
id = &"wakecleaver"
display_name = "Wakecleaver"
description = "Root-tempered steel drawn from a collapsed fracture. A quick, heavy edge for returning to crowded hunting grounds."
item_type = "weapon"
rarity = &"rare"
stackable = false
equipment_slot = &"weapon"
required_level = 4
modifiers = {"attack": 34.0, "attack_speed": 0.16}
value = 90
color = Color(0.3, 0.8, 1, 1)
icon = ExtResource("icon")
visual = ExtResource("visual")
upgrade_profile = ExtResource("upgrade")
attacks = Array[ExtResource("attack")]([ExtResource("a"), ExtResource("b"), ExtResource("c")])
