shape = "none"
reach = 5
radius = 1.6
angle = 360
windup = 0.01
recovery = 0.16
cooldown = 6
animation = &"skill_step"
color = Color(0.25, 0.85, 1, 1)
icon = ExtResource("icon")
requirement_text = "Sword required. Cast freely while moving."
consumes_answer = false
effects = Array[ExtResource("base")]([SubResource("Effect0"), SubResource("Effect1"), SubResource("Effect2")])
